+def _disable_fused_sdpa_if_needed():
+    """torch 2.0.1's flash / mem-efficient attention kernels miscompile on sm_90
+    (H100): the UNet backward dies with "GET was unable to find an engine" or an
+    illegal instruction. The math fallback is correct on every arch and the
+    attention blocks here are tiny (8x8 and 4x4), so the cost is negligible.
+    Set DISABLE_FUSED_SDPA=0 to keep the fused kernels.
+    """
+    if os.environ.get("DISABLE_FUSED_SDPA", "1") != "1":
+        return
+    if not hasattr(torch.backends.cuda, "enable_flash_sdp"):
+        return
+    torch.backends.cuda.enable_flash_sdp(False)
+    torch.backends.cuda.enable_mem_efficient_sdp(False)
+    torch.backends.cuda.enable_math_sdp(True)
+    print("DISABLE_FUSED_SDPA=1: using math attention kernels")
+
+
 def run_experiment(args, seed: int, device: torch.device):
